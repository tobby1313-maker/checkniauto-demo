# Required
GEMINI_PRIMARY_API_KEY=
FLASK_SECRET_KEY=

# Optional provider fallback
GEMINI_BACKUP_API_KEY=
CHECKNI_TEXT_MODEL=gemini-3.8-flash
CHECKNI_TEXT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-2.5-flash
CHECKNI_VISION_MODEL=gemini-2.5-flash
CHECKNI_VISION_FALLBACK_MODELS=gemini-2.5-flash-lite

# Runtime
CHECKNI_ACCESS_MODE=beta
CHECKNI_PRICE_EUR=1.99
CHECKNI_MAX_CONCURRENT_JOBS=2
CHECKNI_MAX_PENDING_JOBS=6
CHECKNI_RATE_LIMIT_PER_IP=5
CHECKNI_JOB_TTL_HOURS=24
CHECKNI_AI_TIMEOUT_SECONDS=90
CHECKNI_SCRAPE_TIMEOUT_SECONDS=90

# Photo pipeline
# Keep the full listing gallery in the final manifest, review unique views in
# labelled 2x2 overview sheets, and inspect only selected images individually.
CHECKNI_MAX_GALLERY_IMAGES=80
CHECKNI_MAX_OVERVIEW_IMAGES=80
CHECKNI_MAX_DETAIL_IMAGES=8
CHECKNI_MIN_DETAIL_IMAGES=4
CHECKNI_OVERVIEW_COLLAGE_SIDE=1536
CHECKNI_IMAGE_MAX_SIDE=1600
CHECKNI_IMAGE_QUALITY=72
CHECKNI_DUPLICATE_AHASH_DISTANCE=3
CHECKNI_DUPLICATE_DHASH_DISTANCE=5
CHECKNI_DUPLICATE_COLOR_DISTANCE=22

CHECKNI_MAX_UPLOAD_MB=30
CHECKNI_DATA_DIR=
