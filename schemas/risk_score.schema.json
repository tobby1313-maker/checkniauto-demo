{
  "title": "Backend Risk Assessment Output",
  "type": "object",
  "required": [
    "allowed_final_verdict"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "policy_version": { "type": "integer" },
    "calibration_status": { "type": "string", "enum": ["UNCALIBRATED", "CALIBRATED"] },
    "decision_status": {
      "type": "string",
      "enum": ["WORTH_INSPECTING", "INSPECT_WITH_RESERVATIONS", "RESOLVE_BEFORE_PROCEEDING", "HIGH_RISK", "DO_NOT_PROCEED"]
    },
    "allowed_final_verdict": { "type": "string" },
    "screening_score": { "type": "integer", "minimum": 1, "maximum": 100 },
    "evidence_quality": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "vehicle_specific_findings": { "type": "array", "items": { "type": "object" } },
    "normal_wear_observations": { "type": "array", "items": { "type": "object" } },
    "model_level_inspection_points": { "type": "array", "items": { "type": "object" } },
    "missing_information": { "type": "array", "items": { "type": "object" } },
    "buyer_actions": { "type": "array", "items": { "type": "string" } },
    "gate_triggers": { "type": "array", "items": { "type": "object" } },
    "score_breakdown": { "type": "object" },
    "risk_score": { "type": "integer", "minimum": 0 },
    "applied_rules": { "type": "array", "items": { "type": "object" } },
    "override_rules_applied": { "type": "array", "items": { "type": "object" } },
    "missing_data_flags": { "type": "array", "items": { "type": "string" } },
    "buyer_priority_checks": { "type": "array", "items": { "type": "string" } },
    "buyer_scorecard": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "enum": [1] },
        "scale_direction": { "type": "string", "enum": ["higher_is_better"] },
        "scores": {
          "type": "object",
          "required": [
            "listing_transparency",
            "market_position",
            "engine_profile",
            "transmission_profile",
            "visual_condition",
            "service_readiness"
          ],
          "properties": {
            "listing_transparency": { "type": "integer", "minimum": 0, "maximum": 100 },
            "market_position": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "engine_profile": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "transmission_profile": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "visual_condition": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "service_readiness": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
          }
        },
        "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    }
  }
}
