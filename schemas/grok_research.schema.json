{
  "title": "Grok Text + Research Output",
  "type": "object",
  "required": [
    "source_role",
    "listing_facts",
    "missing_or_uncertain_data",
    "consistency_checks",
    "vin_check",
    "knowledge_base_findings",
    "web_research_findings",
    "market_assessment",
    "text_research_risk_flags"
  ],
  "properties": {
    "source_role": { "type": "string", "pattern": "text_research" },
    "listing_facts": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "price": { "type": "string" },
        "year": { "type": "string" },
        "mileage": { "type": "string" },
        "engine": { "type": "string" },
        "power": { "type": "string" },
        "fuel": { "type": "string" },
        "transmission": { "type": "string" },
        "drive": { "type": "string" },
        "vin": { "type": "string" },
        "seller": { "type": "string" },
        "origin_or_country": { "type": "string" },
        "service_history": { "type": "string" },
        "equipment": { "type": "array", "items": { "type": "string" } }
      }
    },
    "missing_or_uncertain_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "consistency_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": { "type": "string" },
          "result": { "type": "string", "enum": ["ok", "concern", "unknown"] },
          "explanation": { "type": "string" }
        }
      }
    },
    "vin_check": {
      "type": "object",
      "properties": {
        "vin_present": { "type": "boolean" },
        "format_check": { "type": "string", "enum": ["ok", "problem", "skipped"] },
        "decoded_information": { "type": "string" },
        "online_history": { "type": "string", "enum": ["verified", "not_available", "requires_manual_verification"] },
        "notes": { "type": "string" }
      }
    },
    "knowledge_base_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "risk": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] },
          "notes": { "type": "string" }
        }
      }
    },
    "web_research_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "source_url": { "type": "string" },
          "source_type": { "type": "string", "enum": ["market", "reliability", "VIN", "recall", "other"] },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] },
          "notes": { "type": "string" }
        }
      }
    },
    "market_assessment": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "summary": { "type": "string" },
        "limitations": { "type": "string" },
        "price_view": { "type": "string", "enum": ["fair", "rather_expensive", "rather_cheap", "unclear", "requires_manual_verification"] }
      }
    },
    "text_research_risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string" },
          "why_it_matters_to_buyer": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] }
        }
      }
    }
  }
}