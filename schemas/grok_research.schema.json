{
  "title": "Grok Text + Research Output",
  "type": "object",
  "required": [
    "source_role",
    "component_identity",
    "evidence_summary",
    "listing_facts",
    "seller_claims",
    "missing_or_uncertain_data",
    "data_conflicts",
    "consistency_checks",
    "vin_check",
    "safety_and_recall",
    "knowledge_base_findings",
    "web_research_findings",
    "technical_risks",
    "market_assessment",
    "market_comparables",
    "expected_costs",
    "text_research_risk_flags",
    "sources_used"
  ],
  "properties": {
    "source_role": { "type": "string", "pattern": "text_research" },
    "component_identity": {
      "type": "object",
      "required": ["schema_version", "identification_status", "generation", "engine", "transmission", "drivetrain", "candidate_variants", "sources", "notes"],
      "properties": {
        "schema_version": { "type": "integer", "enum": [1] },
        "identification_status": { "type": "string", "enum": ["VERIFIED", "PROBABLE", "AMBIGUOUS", "UNKNOWN"] },
        "generation": { "type": "object" },
        "engine": { "type": "object" },
        "transmission": { "type": "object" },
        "drivetrain": { "type": "object" },
        "candidate_variants": { "type": "array" },
        "sources": { "type": "array" },
        "notes": { "type": "array" }
      }
    },
    "evidence_summary": {
      "type": "object",
      "properties": {
        "data_completeness_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overall_confidence": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "strongest_evidence": { "type": "array", "items": { "type": "string" } },
        "weakest_evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "listing_facts": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "price": { "type": "string" },
        "asking_price_gross_eur": { "type": ["integer", "number", "null"] },
        "asking_price_net_eur": { "type": ["integer", "number", "null"] },
        "vat_context": { "type": "string" },
        "registration_date": { "type": "string" },
        "year": { "type": "string" },
        "mileage": { "type": "string" },
        "advertised_mileage_km": { "type": ["integer", "number", "null"] },
        "photo_odometer_km": { "type": ["integer", "number", "null"] },
        "engine": { "type": "string" },
        "power": { "type": "string" },
        "fuel": { "type": "string" },
        "color": { "type": "string" },
        "transmission": { "type": "string" },
        "drive": { "type": "string" },
        "vin": { "type": "string" },
        "seller": { "type": "string" },
        "origin_or_country": { "type": "string" },
        "service_history": { "type": "string" },
        "equipment": { "type": "array", "items": { "type": "string" } }
      }
    },
    "seller_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "evidence_category": {
            "type": "string",
            "enum": ["CONFIRMED", "LISTING_CLAIM", "VISUAL_INDICATION", "MODEL_LEVEL_RISK", "NEEDS_VERIFICATION"]
          },
          "verification_status": { "type": "string" },
          "buyer_relevance": { "type": "string" }
        }
      }
    },
    "missing_or_uncertain_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "data_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": { "type": "string" },
          "source_a": { "type": "string" },
          "source_b": { "type": "string" },
          "interpretation": { "type": "string" },
          "importance": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "consistency_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": { "type": "string" },
          "result": { "type": "string", "enum": ["ok", "concern", "unknown"] },
          "explanation": { "type": "string" }
        }
      }
    },
    "vin_check": {
      "type": "object",
      "properties": {
        "vin_present": { "type": "boolean" },
        "format_check": { "type": "string", "enum": ["ok", "problem", "skipped"] },
        "decoded_information": { "type": "string" },
        "local_validation": { "type": "object" },
        "online_history": {
          "type": "string",
          "enum": ["verified", "not_available", "requires_manual_verification"]
        },
        "notes": { "type": "string" }
      }
    },
    "safety_and_recall": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NO_RELEVANT_CAMPAIGN_FOUND", "CAMPAIGN_CONFIRMED_COMPLETED", "POSSIBLE_CAMPAIGN_NEEDS_VIN_CHECK", "OPEN_CAMPAIGN", "INSUFFICIENT_DATA"]
        },
        "summary": { "type": "string" },
        "required_action": { "type": "string" },
        "evidence_category": {
          "type": "string",
          "enum": ["CONFIRMED", "LISTING_CLAIM", "VISUAL_INDICATION", "MODEL_LEVEL_RISK", "NEEDS_VERIFICATION"]
        },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "knowledge_base_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "risk": { "type": "string" },
          "evidence_category": {
            "type": "string",
            "enum": ["CONFIRMED", "LISTING_CLAIM", "VISUAL_INDICATION", "MODEL_LEVEL_RISK", "NEEDS_VERIFICATION"]
          },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoka", "Stredna", "Nizka"] },
          "notes": { "type": "string" }
        }
      }
    },
    "web_research_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "evidence_category": {
            "type": "string",
            "enum": ["CONFIRMED", "LISTING_CLAIM", "VISUAL_INDICATION", "MODEL_LEVEL_RISK", "NEEDS_VERIFICATION"]
          },
          "source_name": { "type": "string" },
          "source_url": { "type": "string" },
          "verified_url": { "type": "boolean" },
          "source_type": {
            "type": "string",
            "enum": ["market", "reliability", "VIN", "recall", "other"]
          },
          "confidence": { "type": "string", "enum": ["Vysoka", "Stredna", "Nizka"] },
          "buyer_impact": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "technical_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "issue": { "type": "string" },
          "risk_level": { "type": "string", "enum": ["HIGH", "MEDIUM", "CHECK"] },
          "evidence_category": {
            "type": "string",
            "enum": ["CONFIRMED", "LISTING_CLAIM", "VISUAL_INDICATION", "MODEL_LEVEL_RISK", "NEEDS_VERIFICATION"]
          },
          "buyer_impact": { "type": "string" },
          "specific_vehicle_evidence": { "type": "string" },
          "verification_action": { "type": "string" },
          "typical_trigger_or_interval": { "type": "string" },
          "estimated_cost_eur_low": { "type": ["integer", "number", "null"] },
          "estimated_cost_eur_high": { "type": ["integer", "number", "null"] },
          "cost_condition": { "type": "string" },
          "source_basis": { "type": "string" },
          "source_name": { "type": "string" },
          "source_url": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoka", "Stredna", "Nizka"] }
        }
      }
    },
    "market_assessment": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean" },
        "advertised_price_eur": { "type": ["integer", "number", "null"] },
        "observed_market_low_eur": { "type": ["integer", "number", "null"] },
        "observed_market_high_eur": { "type": ["integer", "number", "null"] },
        "observed_market_average_eur": { "type": ["integer", "number", "null"] },
        "comparable_count": { "type": ["integer", "null"] },
        "public_comparable_count": { "type": ["integer", "null"] },
        "eur_priced_comparable_count": { "type": ["integer", "null"] },
        "benchmark_comparable_count": { "type": ["integer", "null"] },
        "benchmark_available": { "type": "boolean" },
        "benchmark_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "benchmark_scope": { "type": "string", "enum": ["SK_CZ", "EU_MIXED_BACKGROUND"] },
        "benchmark_tolerance_stage": { "type": "string", "enum": ["NONE", "STRICT", "EXPANDED_YEAR", "EXPANDED_MILEAGE"] },
        "benchmark_median_eur": { "type": ["integer", "number", "null"] },
        "local_market_median_eur": { "type": ["integer", "number", "null"] },
        "foreign_background_median_eur": { "type": ["integer", "number", "null"] },
        "price_delta_percent": { "type": ["integer", "number", "null"] },
        "summary": { "type": "string" },
        "limitations": { "type": "string" },
        "negotiation_anchor_eur": { "type": ["integer", "number", "null"] },
        "negotiation_reason": { "type": "string" },
        "price_view": {
          "type": "string",
          "enum": ["fair", "rather_expensive", "rather_cheap", "unclear", "requires_manual_verification"]
        }
      }
    },
    "market_search_summary": {
      "type": "object",
      "properties": {
        "pass_count": { "type": "integer" },
        "nothing_found_passes": { "type": "integer" },
        "search_results_found_count": { "type": "integer" },
        "candidate_count": { "type": "integer" },
        "url_unverified_count": { "type": "integer" },
        "verified_detail_count": { "type": "integer" },
        "verified_background_count": { "type": "integer" }
      }
    },
    "market_comparables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "year": { "type": ["integer", "null"] },
          "vin": { "type": "string" },
          "seller_or_location": { "type": "string" },
          "source_country": { "type": "string" },
          "market_scope": { "type": "string", "enum": ["PUBLIC_SK_CZ", "BACKGROUND_EU"] },
          "similarity_tier": { "type": "string", "enum": ["A", "B", "C"] },
          "price_basis": { "type": "string", "enum": ["gross_asking", "net", "auction", "damaged", "export_only", "unknown"] },
          "price_eur": { "type": ["integer", "number", "null"] },
          "price_display": { "type": "string" },
          "mileage_km": { "type": ["integer", "number", "null"] },
          "material_difference": { "type": "string" },
          "relevance": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "source_name": { "type": "string" },
          "source_url": { "type": "string" },
          "claimed_source_url": { "type": "string" },
          "evidence_url": { "type": "string" },
          "verified_url": { "type": "boolean" },
          "url_verification_status": { "type": "string", "enum": ["VERIFIED_DETAIL", "VERIFIED_SEARCH_RESULT", "URL_UNVERIFIED"] },
          "background_evidence_verified": { "type": "boolean" },
          "data_provenance": { "type": "string", "enum": ["DIRECT_PORTAL_SEARCH", "GROUNDED_DETAIL", "GROUNDED_SEARCH_RESULT", "UNVERIFIED_MODEL_OUTPUT"] },
          "search_pass": { "type": "string" },
          "display_in_report": { "type": "boolean" }
        }
      }
    },
    "expected_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "why": { "type": "string" },
          "estimated_cost_eur_low": { "type": ["integer", "number", "null"] },
          "estimated_cost_eur_high": { "type": ["integer", "number", "null"] },
          "cost_type": { "type": "string", "enum": ["initial_service", "diagnostic", "conditional_repair", "major_downside"] },
          "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "basis": { "type": "string" }
        }
      }
    },
    "text_research_risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk": { "type": "string" },
          "why_it_matters_to_buyer": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoka", "Stredna", "Nizka"] }
        }
      }
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": ["OFFICIAL", "REGULATORY", "LISTING", "VEHICLE_HISTORY", "MARKET_COMPARABLE", "TECHNICAL_PUBLICATION", "REPAIR_SOURCE", "OWNER_REPORT", "OTHER"]
          },
          "reliability": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "source_url": { "type": "string" },
          "verified_url": { "type": "boolean" },
          "used_for": { "type": "string" }
        }
      }
    }
  }
}
