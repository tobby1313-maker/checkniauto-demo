{
  "title": "Gemini Vision Output",
  "type": "object",
  "required": [
    "source_role",
    "photos_provided",
    "photo_limitations",
    "exterior_observations",
    "interior_observations",
    "dashboard_or_warning_lights",
    "visible_red_flags",
    "mileage_wear_consistency",
    "visual_verdict",
    "must_not_infer"
  ],
  "properties": {
    "source_role": { "type": "string", "pattern": "vision" },
    "photos_provided": { "type": "boolean" },
    "photo_limitations": { "type": "array", "items": { "type": "string" } },
    "exterior_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "severity": { "type": "string", "enum": ["minor", "medium", "serious", "unknown"] },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] },
          "buyer_relevance": { "type": "string" }
        }
      }
    },
    "interior_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "severity": { "type": "string", "enum": ["minor", "medium", "serious", "unknown"] },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] },
          "buyer_relevance": { "type": "string" }
        }
      }
    },
    "dashboard_or_warning_lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] },
          "requires_verification": { "type": "boolean" }
        }
      }
    },
    "visible_red_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "red_flag": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] }
        }
      }
    },
    "mileage_wear_consistency": {
      "type": "object",
      "properties": {
        "assessment": { "type": "string", "enum": ["consistent", "possibly_inconsistent", "cannot_assess"] },
        "explanation": { "type": "string" },
        "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] }
      }
    },
    "visual_verdict": { "type": "string" },
    "must_not_infer": { "type": "array", "items": { "type": "string" } }
  }
}