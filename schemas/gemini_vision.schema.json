{
  "title": "Gemini Vision Output",
  "type": "object",
  "required": [
    "source_role",
    "photos_provided",
    "photo_limitations",
    "exterior_observations",
    "interior_observations",
    "dashboard_or_warning_lights",
    "visible_red_flags",
    "mileage_wear_consistency",
    "visual_verdict",
    "must_not_infer"
  ],
  "properties": {
    "source_role": { "type": "string", "pattern": "vision" },
    "analysis_status": { "type": "string", "enum": ["completed", "unavailable", "not_provided"] },
    "photos_provided": { "type": "boolean" },
    "photo_coverage": {
      "type": "object",
      "properties": {
        "coverage_mode": {
          "type": "string",
          "enum": ["detail_all", "full_gallery_overview", "detail_limited", "raw_limited", "none"]
        },
        "original_count": { "type": "integer" },
        "analyzed_count": { "type": "integer" },
        "full_gallery_overview": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "odometer": {
      "type": "object",
      "properties": {
        "visible": { "type": "boolean" },
        "reading_km": { "type": ["integer", "number", "null"] },
        "photo_label": { "type": "string" },
        "confidence": { "type": ["string", "null"], "enum": ["HIGH", "MEDIUM", "LOW", null] },
        "notes": { "type": "string" }
      }
    },
    "view_coverage": {
      "type": "object",
      "properties": {
        "exterior": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] },
        "interior": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] },
        "dashboard": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] },
        "engine_bay": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] },
        "tires": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] },
        "underbody": { "type": "string", "enum": ["visible_detail", "visible_overview_only", "missing", "unknown"] }
      }
    },
    "supported_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["body", "paint", "corrosion", "interior", "dashboard", "odometer", "wheels", "tires", "documents", "equipment", "other"]
          },
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "evidence_category": { "type": "string", "enum": ["VISUAL_INDICATION", "CONFIRMED"] },
          "importance": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "missing_views": { "type": "array", "items": { "type": "string" } },
    "photo_limitations": { "type": "array", "items": { "type": "string" } },
    "exterior_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "assessment": { "type": "string", "enum": ["reassuring", "neutral", "concern", "uncertain"] },
          "severity": { "type": "string", "enum": ["none", "minor", "medium", "serious", "unknown"] },
          "buyer_impact": { "type": "string", "enum": ["cosmetic", "maintenance", "mechanical", "safety", "identity_legal", "value"] },
          "age_context": { "type": "string", "enum": ["expected", "worse_than_expected", "better_than_expected", "unknown"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "buyer_relevance": { "type": "string" }
        }
      }
    },
    "interior_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "assessment": { "type": "string", "enum": ["reassuring", "neutral", "concern", "uncertain"] },
          "severity": { "type": "string", "enum": ["none", "minor", "medium", "serious", "unknown"] },
          "buyer_impact": { "type": "string", "enum": ["cosmetic", "maintenance", "mechanical", "safety", "identity_legal", "value"] },
          "age_context": { "type": "string", "enum": ["expected", "worse_than_expected", "better_than_expected", "unknown"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "buyer_relevance": { "type": "string" }
        }
      }
    },
    "dashboard_or_warning_lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "observation": { "type": "string" },
          "assessment": { "type": "string", "enum": ["reassuring", "neutral", "concern", "uncertain"] },
          "severity": { "type": "string", "enum": ["none", "minor", "medium", "serious", "unknown"] },
          "buyer_impact": { "type": "string", "enum": ["cosmetic", "maintenance", "mechanical", "safety", "identity_legal", "value"] },
          "age_context": { "type": "string", "enum": ["expected", "worse_than_expected", "better_than_expected", "unknown"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "requires_verification": { "type": "boolean" }
        }
      }
    },
    "visible_red_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "photo_label": { "type": "string" },
          "red_flag": { "type": "string" },
          "assessment": { "type": "string", "enum": ["reassuring", "neutral", "concern", "uncertain"] },
          "severity": { "type": "string", "enum": ["none", "minor", "medium", "serious", "unknown"] },
          "buyer_impact": { "type": "string", "enum": ["cosmetic", "maintenance", "mechanical", "safety", "identity_legal", "value"] },
          "age_context": { "type": "string", "enum": ["expected", "worse_than_expected", "better_than_expected", "unknown"] },
          "why_it_matters": { "type": "string" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "mileage_wear_consistency": {
      "type": "object",
      "properties": {
        "assessment": { "type": "string", "enum": ["consistent", "possibly_inconsistent", "cannot_assess"] },
        "explanation": { "type": "string" },
        "confidence": { "type": "string", "enum": ["Vysoká", "Stredná", "Nízka"] }
      }
    },
    "visual_verdict": { "type": "string" },
    "visible_vin": { "type": "string" },
    "must_not_infer": { "type": "array", "items": { "type": "string" } }
  }
}
